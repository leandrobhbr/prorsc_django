# Variáveis de produção. Copie para /etc/prorsc-django.env (dono root, grupo prorsc, chmod 640).
# Gere cada segredo com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=0
SECRET_KEY=GERE-UM-SEGREDO-COM-50-CARACTERES-OU-MAIS
JWT_SECRET=GERE-OUTRO-SEGREDO
JWT_TTL_MINUTOS=480
HASHIDS_SALT=GERE-UM-SALT
SQLITE_PATH=/var/lib/prorsc-django/prorsc.db
# 127.0.0.1: usado pelo health check do deploy/atualizar.sh.
ALLOWED_HOSTS=calculadora.exemplo.com.br,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://calculadora.exemplo.com.br
# Front e API no mesmo domínio (via Apache): CORS só é necessário em desenvolvimento.
CORS_ORIGINS=https://calculadora.exemplo.com.br
# Ligue o HSTS só depois de confirmar que o HTTPS funciona (31536000 = 1 ano).
SECURE_HSTS_SECONDS=0
# Usados no build do frontend (deploy/atualizar.sh). O navegador chama a API no mesmo domínio.
# Na raiz do domínio:  FRONT_PUBLIC_PATH=/                 FRONT_API_URL=/api/v1
# Em subpasta:         FRONT_PUBLIC_PATH=/prorsc_django/   FRONT_API_URL=/prorsc_django/api/v1
# Pasta onde o frontend compilado é publicado (o Apache serve esta pasta).
FRONT_DIR=/var/www/prorsc-django
FRONT_PUBLIC_PATH=/
FRONT_API_URL=/api/v1
# Só em subpasta: prefixo público da aplicação (corrige links e login do Django Admin).
FORCE_SCRIPT_NAME=
GUNICORN_BIND=127.0.0.1:8003
GUNICORN_WORKERS=3
